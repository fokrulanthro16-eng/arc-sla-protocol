# ArcSLA Protocol — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Deployed ArcSLAVault contract address (Arc Testnet or Mainnet)
# Testnet:  0xdedc6e0d87dc3dd906a7532c0f8946fedbca7057
# Mainnet:  deploy yourself — see README Quickstart
VITE_CONTRACT_ADDRESS=0xdedc6e0d87dc3dd906a7532c0f8946fedbca7057

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# WalletConnect Cloud project ID (https://cloud.walletconnect.com)
# Arc Studio provides its own when running inside the workbench.
# Required if self-hosting or deploying to Vercel/Netlify.
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ─── ARC STUDIO RPC PROXY ──────────────────────────────────────────────────
# Injected automatically inside Arc Studio. Outside Arc Studio,
# leave unset — the app falls back to the public Arc Testnet RPC.
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
